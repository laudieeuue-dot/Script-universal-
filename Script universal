local function makeButton(key, callback, suffixFunction)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 38)
    button.BackgroundColor3 = Color3.fromRGB(32, 34, 45)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 12
    button.Font = Enum.Font.GothamSemibold
    button.Parent = content
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)

    local update = bindText(button, key, suffixFunction)

    button.Activated:Connect(function()
        callback()
        update()
    end)

    return button, update
end

local function makeInput(key, defaultValue, callback)
    local box = Instance.new("Frame")
    box.Size = UDim2.new(1, 0, 0, 66)
    box.BackgroundColor3 = Color3.fromRGB(23, 24, 33)
    box.Parent = content
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 7)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -12, 0, 24)
    label.Position = UDim2.fromOffset(8, 2)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = 12
    label.Font = Enum.Font.GothamSemibold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = box
    bindText(label, key)

    local input = Instance.new("TextBox")
    input.Size = UDim2.new(0.62, -10, 0, 29)
    input.Position = UDim2.fromOffset(7, 31)
    input.BackgroundColor3 = Color3.fromRGB(15, 16, 22)
    input.TextColor3 = Color3.new(1, 1, 1)
    input.Text = tostring(defaultValue)
    input.PlaceholderText = T("PLACEHOLDER")
    input.TextSize = 12
    input.Font = Enum.Font.Gotham
    input.ClearTextOnFocus = false
    input.Parent = box
    Instance.new("UICorner", input).CornerRadius = UDim.new(0, 5)

    local apply = Instance.new("TextButton")
    apply.Size = UDim2.new(0.34, -5, 0, 29)
    apply.Position = UDim2.new(0.66, 0, 0, 31)
    apply.BackgroundColor3 = Themes[Config.Theme]
    apply.TextColor3 = Color3.new(1, 1, 1)
    apply.TextSize = 11
    apply.Font = Enum.Font.GothamBold
    apply.Parent = box
    Instance.new("UICorner", apply).CornerRadius = UDim.new(0, 5)

    local updateApply = bindText(apply, "APPLY")
    addAccent(apply, "BackgroundColor3")

    table.insert(textUpdaters, function()
        if input.Parent then
            input.PlaceholderText = T("PLACEHOLDER")
        end
    end)

    local version = 0

    apply.Activated:Connect(function()
        local value = tonumber(input.Text)

        if not value then
            apply.Text = T("INVALID")
            return
        end

        callback(value)
        version += 1

        local current = version
        apply.Text = "OK!"

        task.delay(1, function()
            if apply.Parent and current == version then
                updateApply()
            end
        end)
    end)
end

