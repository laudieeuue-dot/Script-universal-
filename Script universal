local minimized = false

local function minimizePanel()
    minimized = true
    main.Visible = false
    reopen.Visible = true
end

local function restorePanel()
    minimized = false
    main.Visible = true
    reopen.Visible = false
end

minimize.Activated:Connect(minimizePanel)
reopen.Activated:Connect(restorePanel)

local reopenDragging = false
local reopenMoved = false
local reopenStart
local reopenPosition
local reopenInput

reopen.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then

        reopenDragging = true
        reopenMoved = false
        reopenStart = input.Position
        reopenPosition = reopen.Position
    end
end)

reopen.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        reopenInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if reopenDragging and input == reopenInput then
        local delta = input.Position - reopenStart

        if delta.Magnitude > 5 then
            reopenMoved = true
        end

        reopen.Position = UDim2.new(
            reopenPosition.X.Scale,
            reopenPosition.X.Offset + delta.X,
            reopenPosition.Y.Scale,
            reopenPosition.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then

        if reopenDragging then
            reopenDragging = false

            if not reopenMoved and minimized then
                restorePanel()
            end
        end
    end
end)

