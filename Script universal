    makeButton("ESP_TITLE", function()
        openPopup("ESP_TITLE", espOptions, function(stateKey)
            State[stateKey] = not State[stateKey]
            updateESP()
        end, true)
    end)

    createLabel(
        "Ative ou desative ESP de jogadores e NPCs.",
        38,
        Color3.fromRGB(155, 158, 172),
        false
    )
end

local function renderMove()
    createLabel(T("MOVE"), 25, Themes[Config.Theme], true)

    makeInput("SPEED", Config.Speed, function(value)
        Config.Speed = math.clamp(value, 0, 250)
        getCharacter()

        if humanoid then
            humanoid.WalkSpeed = Config.Speed
        end
    end)

    makeInput("JUMP", Config.Jump, function(value)
        Config.Jump = math.clamp(value, 0, 300)
        getCharacter()

        if humanoid then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = Config.Jump
        end
    end)

    makeInput("FLYSPEED", Config.FlySpeed, function(value)
        Config.FlySpeed = math.clamp(value, 5, 250)
    end)

    makeButton("FLY", function()
        if State.Fly then
            stopFly()
        else
            startFly()
        end
    end, function()
        return ": " .. (State.Fly and T("ON") or T("OFF"))
    end)
end

local function renderAim()
    createLabel(T("AIM_TITLE"), 25, Themes[Config.Theme], true)

    makeButton("HEAD", function()
        State.Aim = not State.Aim
    end, function()
        return ": " .. (State.Aim and T("ON") or T("OFF"))
    end)

    makeInput("FOV", Config.FOV, function(value)
        Config.FOV = math.clamp(value, 20, 600)
    end)

    makeInput("SMOOTH", Config.Smooth, function(value)
        Config.Smooth = math.clamp(value, 0.01, 1)
    end)

    makeButton("FOVCIRCLE", function()
        State.ShowFOV = not State.ShowFOV
        fovCircle.Visible = State.ShowFOV
    end, function()
        return ": " .. (State.ShowFOV and T("ON") or T("OFF"))
    end)
end

local function renderSettings()
    createLabel(T("PERSONAL"), 25, Themes[Config.Theme], true)

