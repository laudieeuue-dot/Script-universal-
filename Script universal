        end
    end

    table.insert(textUpdaters, updateClose)
    updateClose()
    close.Activated:Connect(closePopup)
end

--====================================================
-- ESP HIGHLIGHT (SUBSTITUI A ESP ANTIGA)
--====================================================

local function removeESP(model)
    local highlight = espObjects[model]

    if highlight then
        highlight:Destroy()
        espObjects[model] = nil
    end
end

local function createESP(model)
    if not model or not model:IsA("Model") then
        return
    end

    if not model:FindFirstChildOfClass("Humanoid") then
        return
    end

    if espObjects[model] then
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "WeslleyESP"
    highlight.Adornee = model
    highlight.FillColor = Themes[Config.Theme]
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.6
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = model

    espObjects[model] = highlight
end

local function updateESP()
    -- ESP DE JOGADORES
    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player then
            local targetCharacter = target.Character

            if State.ESPPlayer and targetCharacter then
                createESP(targetCharacter)
            elseif targetCharacter then
                removeESP(targetCharacter)
            end
        end
    end

    -- ESP DE NPCs
    local folder = Workspace:FindFirstChild("NPCs")

    if folder then
        for _, npc in ipairs(folder:GetChildren()) do
            if State.ESPNPC then
                createESP(npc)
            else
                removeESP(npc)
            end
        end
    end

    -- LIMPEZA DE MODELOS REMOVIDOS
    for model in pairs(espObjects) do
        if not model or not model.Parent then
            removeESP(model)
        end
    end
end

