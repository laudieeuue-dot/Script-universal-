--====================================================
-- MIRA NA CABEÇA
--====================================================

local function closestHead()
    local closest
    local shortest = Config.FOV
    local center = camera.ViewportSize / 2

    local function check(model)
        if model == character then
            return
        end

        local hum = model:FindFirstChildOfClass("Humanoid")
        local head = model:FindFirstChild("Head")

        if not hum or hum.Health <= 0 or not head then
            return
        end

        local pos, visible = camera:WorldToViewportPoint(head.Position)

        if not visible or pos.Z <= 0 then
            return
        end

        local distance = (
            Vector2.new(pos.X, pos.Y) - center
        ).Magnitude

        if distance < shortest then
            shortest = distance
            closest = head
        end
    end

    if State.Aim then
        for _, target in ipairs(Players:GetPlayers()) do
            if target ~= player and target.Character then
                check(target.Character)
            end
        end

        local folder = Workspace:FindFirstChild("NPCs")

        if folder then
            for _, npc in ipairs(folder:GetChildren()) do
                check(npc)
            end
        end
    end

    return closest
end

--====================================================
-- LOOP PRINCIPAL
--====================================================

local espTimer = 0

RunService.Heartbeat:Connect(function(dt)
    getCharacter()

    if State.Fly and root and humanoid and flyVelocity then
        local move = humanoid.MoveDirection
        local look = camera.CFrame.LookVector

        if move.Magnitude < 0.05 then
            flyVelocity.Velocity = Vector3.zero
        else
            local horizontal = Vector3.new(move.X, 0, move.Z)
            local cameraForward = Vector3.new(look.X, 0, look.Z)

            if cameraForward.Magnitude > 0.001 then
                cameraForward = cameraForward.Unit
            else
                cameraForward = Vector3.new(0, 0, -1)
            end

            local forwardAmount = horizontal:Dot(cameraForward)
            local vertical = look.Y * forwardAmount

            local direction = Vector3.new(
                horizontal.X,
                vertical,
                horizontal.Z
            )

            if direction.Magnitude > 1 then
                direction = direction.Unit
            end

            flyVelocity.Velocity = direction * Config.FlySpeed
        end
    end

    espTimer += dt

    if espTimer >= 0.05 then
        espTimer = 0
        updateESP()
    end
end)

RunService.RenderStepped:Connect(function()
    camera = Workspace.CurrentCamera

    if State.ShowFOV then
        fovCircle.Size = UDim2.fromOffset(
            Config.FOV * 2,
            Config.FOV * 2
        )
        fovStroke.Color = Themes[Config.Theme]
    end

    if State.Aim then
        local head = closestHead()

        if head then
            local desired = CFrame.lookAt(
                camera.CFrame.Position,
                head.Position
            )

            camera.CFrame = camera.CFrame:Lerp(
                desired,
                Config.Smooth
            )
        end
    end
end)

