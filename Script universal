local currentTab = 1
local tabButtons = {}
local textUpdaters = {}
local accentObjects = {}
local espObjects = {}
local renderContent

local function addAccent(object, property)
    table.insert(accentObjects, {
        Object = object,
        Property = property
    })
end

local function bindText(object, key, suffixFunction)
    local function update()
        if object and object.Parent then
            local suffix = suffixFunction and suffixFunction() or ""
            object.Text = T(key) .. suffix
        end
    end

    table.insert(textUpdaters, update)
    update()
    return update
end

local function refreshLanguage()
    for _, update in ipairs(textUpdaters) do
        update()
    end

    if renderContent then
        renderContent()
    end
end

local function updateTheme()
    local color = Themes[Config.Theme]

    outline.Color = color
    minimize.BackgroundColor3 = color
    reopen.BackgroundColor3 = color
    content.ScrollBarImageColor3 = color

    for _, item in ipairs(accentObjects) do
        if item.Object and item.Object.Parent then
            item.Object[item.Property] = color
        end
    end

    for index, button in ipairs(tabButtons) do
        button.BackgroundColor3 =
            index == currentTab and color
            or Color3.fromRGB(32, 34, 45)
    end

    for _, highlight in pairs(espObjects) do
        if highlight and highlight.Parent then
            highlight.FillColor = color
        end
    end
end

